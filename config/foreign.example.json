{
  "role": "foreign",
  "tunnel_id": "replace_tunnel_id",
  "shared_secret": "replace_shared_secret",
  "uplink_listen": "0.0.0.0:7000",
  "inner_bridge_listen": "127.0.0.1:5001",
  "inner_peer": "127.0.0.1:51820",
  "iran_downlink": "iran_ip:7001",
  "downlink_mode": "udp",
  "downlink_source": "source_ip_assigned_to_server",
  "downlink_source_port": 7002,
  "health_listen": "127.0.0.1:9082",
  "metrics_file": "/var/lib/h3ntun/metrics.json",
  "replay_state_file": "/var/lib/h3ntun/foreign-replay.json",
  "replay_checkpoint_interval_seconds": 0.05,
  "replay_checkpoint_batch_frames": 128,
  "keepalive_seconds": 5,
  "health_timeout_seconds": 20,
  "recv_buffer_bytes": 4194304,
  "fragment_payload_bytes": 1200,
  "fec_enabled": true,
  "reliable": true,
  "retransmit_timeout_seconds": 0.5,
  "max_retries": 8,
  "max_pending_messages": 2048,
  "reassembly_timeout_seconds": 30
}

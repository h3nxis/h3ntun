[Unit]
Description=Authenticated Asymmetric UDP Link
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=h3ntun
Group=h3ntun
WorkingDirectory=/opt/h3ntun/app
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/h3ntun/venv/bin/h3ntun run --config /etc/h3ntun/config.json
ExecStartPre=/opt/h3ntun/venv/bin/h3ntun check --config /etc/h3ntun/config.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0027
StateDirectory=h3ntun
StateDirectoryMode=0750
ReadWritePaths=/var/lib/h3ntun
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
